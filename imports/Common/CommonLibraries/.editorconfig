root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.props]
indent_style = space
indent_size = 2

[*.csproj]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4

dotnet_sort_system_directives_first = true
dotnet_seperate_import_directive_groups = true

# Messaging API intentionally uses established EventHandler and Delegate suffixes.
dotnet_diagnostic.CA1711.severity = none